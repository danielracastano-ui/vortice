# Identidad de la marca. Cambia estos valores y se actualizan en todo el sitio
# (cabecera, pie, metadatos, páginas legales).
VITE_SITE_NAME=Vórtice
# URL pública definitiva del sitio, sin barra final (para la imagen al compartir).
# Rellénala cuando tengas el dominio. Ej.: https://tudominio.com
VITE_SITE_URL=
# Déjalo vacío para usar Netlify Forms (modo de producción). Solo se rellena si
# algún día el formulario debe enviarse a otra API (POST JSON).
VITE_CONTACT_ENDPOINT=
